# Copy to secrets.toml and fill in. secrets.toml is gitignored; this
# example is not, so never put a real key in this file.
#
# config.py reads these, and the environment wins over them, so a key
# exported in a shell overrides whatever is here.

# Which NBA adapter the builder and the scheduled update use: csv
# (static local files, the default), bbr (a local Basketball-Reference
# scrape) or nba_api (NBA.com, live).
#
# csv is the default deliberately. Both other adapters are cleared only
# for private, local, non-commercial use -- read the licensing note at the
# top of nba/nba_source_api.py and nba/nba_source_bbr.py before selecting
# one, and do not select one for a hosted or shared deployment.
SPORTS_DATA_NBA_SOURCE = "csv"

# Only needed for an NBA source that requires authentication. NBA.com's
# undocumented endpoints, which nba/nba_source_api.py uses by default, do
# not: leave this empty unless you are pointing the adapter at a provider
# that issues keys.
NBA_API_KEY = ""
