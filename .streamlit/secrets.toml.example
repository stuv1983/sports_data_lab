# Copy to secrets.toml and fill in. secrets.toml is gitignored; this
# example is not, so never put a real key in this file.
#
# config.py reads these, and the environment wins over them, so a key
# exported in a shell overrides whatever is here.

# Only needed for an NBA source that requires authentication. NBA.com's
# undocumented endpoints, which nba/nba_source_api.py uses by default, do
# not: leave this empty unless you are pointing the adapter at a provider
# that issues keys.
NBA_API_KEY = ""
